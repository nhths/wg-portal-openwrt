# The toolbox of the package: UPX to pack the binary, GNU tar to assemble the
# .ipk and Jinja2 to render the files of the package.
#
#   docker build -f Dockerfile.pkg -t wg-portal-pkg:local .
#   docker run --rm -v "$PWD/dist:/w" wg-portal-pkg:local
#
# Debian, because the busybox tar of Alpine does not know the options the
# package needs (--numeric-owner, --owner, --group). UPX is the official
# release of the version Alpine ships (4.2.4), so the packed binary is the
# same byte for byte.
FROM debian:bookworm-slim

ARG UPX_VERSION=4.2.4

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      file \
      python3 \
      python3-jinja2 \
      xz-utils \
 && rm -rf /var/lib/apt/lists/*

# The release of UPX for Linux is a static binary. The check at the end of the
# line fails the build right here if the image is not the platform the
# release is for.
RUN curl -fsSL -o /tmp/upx.tar.xz \
      "https://github.com/upx/upx/releases/download/v${UPX_VERSION}/upx-${UPX_VERSION}-amd64_linux.tar.xz" \
 && tar -xJf /tmp/upx.tar.xz -C /tmp \
 && install -m 755 "/tmp/upx-${UPX_VERSION}-amd64_linux/upx" /usr/local/bin/upx \
 && rm -rf /tmp/upx* \
 && upx --version

COPY scripts/build-ipk.sh /opt/wg-portal/build-ipk.sh
COPY templates/ /opt/wg-portal/templates/

WORKDIR /w
ENTRYPOINT ["/opt/wg-portal/build-ipk.sh"]
