# The toolbox of the package: ansible renders the templates of the package and
# assembles it, UPX packs the binary and GNU tar builds the archive.
#
#   docker build -f Dockerfile.pkg -t wg-portal-pkg:local .
#   docker run --rm -v "$PWD/dist:/w" wg-portal-pkg:local
#
# Debian, because the busybox tar of Alpine does not know the options the
# package needs (--numeric-owner, --owner, --group). UPX is the official
# release of the version Alpine ships (4.2.4), so the packed binary is the
# same byte for byte.
FROM debian:bookworm-slim

ARG UPX_VERSION=4.2.4

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      file \
      python3 \
      python3-venv \
      xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Ansible renders the templates of the package — the same engine the setup of
# the router uses, so there is one template syntax in the project.
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir "ansible-core>=2.16,<2.19"

ENV PATH=/opt/venv/bin:$PATH
# The container runs as the user of the host, which has no home directory in
# the image: the temporary files of ansible have to live in /tmp.
ENV ANSIBLE_LOCAL_TEMP=/tmp/ansible-local \
    ANSIBLE_REMOTE_TEMP=/tmp/ansible-remote \
    ANSIBLE_CONFIG=/opt/wg-portal/ansible/ansible.cfg \
    HOME=/tmp

# The release of UPX for Linux is a static binary. The check at the end of the
# line fails the build right here if the image is not the platform the
# release is for.
RUN curl -fsSL -o /tmp/upx.tar.xz \
      "https://github.com/upx/upx/releases/download/v${UPX_VERSION}/upx-${UPX_VERSION}-amd64_linux.tar.xz" \
 && tar -xJf /tmp/upx.tar.xz -C /tmp \
 && install -m 755 "/tmp/upx-${UPX_VERSION}-amd64_linux/upx" /usr/local/bin/upx \
 && rm -rf /tmp/upx* \
 && upx --version

COPY ansible/ /opt/wg-portal/ansible/
COPY templates/ /opt/wg-portal/templates/

WORKDIR /w
ENTRYPOINT ["ansible-playbook", "-i", "/opt/wg-portal/ansible/inventory.ini", "/opt/wg-portal/ansible/pack.yml"]
