# The toolbox of the package: UPX to pack the binary, the apk-tools to build
# the package and the index of the feed, and Jinja2 to render the files of the
# package.
#
#   docker build -f Dockerfile.pkg -t wg-portal-pkg:local .
#   docker run --rm -v "$PWD/dist:/w" wg-portal-pkg:local
FROM debian:bookworm-slim

ARG UPX_VERSION=4.2.4
ARG APK_VERSION=3.0.9
ARG APK_RELEASE=r0
ARG APK_URL=https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64
ARG APK_SHA256=0a1a0682375f66a83b7b903f6e4638ccfe312547d50d336b5f2be9fc391281be

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      file \
      python3 \
      python3-jinja2 \
      xz-utils \
 && rm -rf /var/lib/apt/lists/*

# The release of UPX for Linux is a static binary. The check at the end of the
# line fails the build right here if the image is not the platform the
# release is for.
RUN curl -fsSL -o /tmp/upx.tar.xz \
      "https://github.com/upx/upx/releases/download/v${UPX_VERSION}/upx-${UPX_VERSION}-amd64_linux.tar.xz" \
 && tar -xJf /tmp/upx.tar.xz -C /tmp \
 && install -m 755 "/tmp/upx-${UPX_VERSION}-amd64_linux/upx" /usr/local/bin/upx \
 && rm -rf /tmp/upx* \
 && upx --version

# The apk-tools of Alpine: the static build, unpacked from the package of
# them.
RUN curl -fsSL -o /tmp/apk.apk \
      "$APK_URL/apk-tools-static-${APK_VERSION}-${APK_RELEASE}.apk" \
 && echo "${APK_SHA256}  /tmp/apk.apk" | sha256sum -c - \
 && mkdir -p /tmp/apk \
 && tar --warning=no-unknown-keyword -xzf /tmp/apk.apk -C /tmp/apk sbin/apk.static \
 && install -m 755 /tmp/apk/sbin/apk.static /usr/local/bin/apk \
 && rm -rf /tmp/apk /tmp/apk.apk \
 && apk --version

COPY scripts/build-apk.sh /opt/wg-portal/build-apk.sh
COPY scripts/make-feed.sh /opt/wg-portal/make-feed.sh
COPY templates/ /opt/wg-portal/templates/

WORKDIR /w
ENTRYPOINT ["/opt/wg-portal/build-apk.sh"]
