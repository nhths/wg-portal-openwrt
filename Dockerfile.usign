# The usign of OpenWrt: the tool that signs the feeds of opkg. The check
# signs the index of its feed with it, and the workflow of the release signs
# the index of the release with the key of the project.
#
#   docker build -f Dockerfile.usign -t wg-portal-usign .
#   docker run --rm -v "$PWD/dist:/w" -v "$HOME/.config/wg-portal/secret.key:/key/secret.key:ro" \
#     wg-portal-usign -S -m /w/Packages -s /key/secret.key -x /w/Packages.sig
#
# The binary is a build of OpenWrt for musl, so it needs the libraries of it:
# Alpine has the same libc, so the binary runs there as it is.
FROM alpine:3.20

ARG OW_REL=24.10.8
RUN apk add --no-cache curl libgcc \
 && BASE=https://downloads.openwrt.org/releases/$OW_REL/packages/x86_64/base \
 && cd /tmp \
 && curl -fsSL "$BASE/" -o index.html \
 && usign_pkg=$(grep -oE 'usign_[^"]*_x86_64\.ipk' index.html | head -1) \
 && libubox_pkg=$(grep -oE 'libubox[0-9][^"]*_x86_64\.ipk' index.html | head -1) \
 && curl -fsSLO "$BASE/$usign_pkg" \
 && curl -fsSLO "$BASE/$libubox_pkg" \
 && mkdir -p u l \
 && cd u && tar -xzf ../usign*.ipk && tar -xzf data.tar.gz \
 && cd ../l && tar -xzf ../libubox*.ipk && tar -xzf data.tar.gz \
 && mkdir -p /opt/usign/lib \
 && cp /tmp/u/usr/bin/usign /opt/usign/ \
 && cp /tmp/l/lib/libubox.so.* /usr/lib/ \
 && cp /tmp/l/lib/libubox.so.* /opt/usign/lib/ \
 && cp /usr/lib/libgcc_s.so.1 /opt/usign/lib/libgcc_s.so.1

ENTRYPOINT ["/opt/usign/usign"]
